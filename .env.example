# ============================================
# Beats Studio — Environment Variables
# Copy to .env and fill in real values
# NEVER commit .env to version control!
# ============================================

# Google Analytics / Tag Manager
VITE_ANALYTICS_KEY=

# Stripe (for future checkout integration)
STRIPE_PUBLIC_KEY=

# Newsletter / Email service (Mailchimp, ConvertKit, etc.)
NEWSLETTER_API_URL=

# Contact form endpoint (Formspree, Netlify Forms, etc.)
CONTACT_FORM_ENDPOINT=
